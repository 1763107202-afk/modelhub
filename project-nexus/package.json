{
  "name": "project-nexus",
  "version": "1.6.0",
  "private": true,
  "description": "中文 Windows 工程工作站",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --check main.js && node --check preload.js && node --check renderer.js && node --check nexus-memory.js && node --check nexus-features.js && node test-memory.js && node test-features.js && node --check nexus-log-diagnostics.js && node test-logs.js",
    "build": "electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "cn.projectnexus.desktop",
    "productName": "PROJECT NEXUS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "nexus-memory.js",
      "!test-memory.js",
      "nexus-features.js",
      "!test-features.js",
      "nexus-log-diagnostics.js",
      "!test-logs.js"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "artifactName": "PROJECT_NEXUS_${version}_${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "docx": "^9.5.1"
  }
}
