{
  "name": "project-nexus",
  "version": "2.0.0-beta.3",
  "private": true,
  "description": "PROJECT NEXUS 2.0 中文 AI 工程工作站（预览版）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --check main.js && node --check preload.js && node --check renderer.js && node --check nexus-memory.js && node --check nexus-features.js && node test-memory.js && node test-features.js && node --check nexus-log-diagnostics.js && node test-logs.js && node test-ipc.js && node test-ui.js && node --check nexus-folders.js && node test-folders.js",
    "build": "electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "jsdom": "^26.1.0"
  },
  "build": {
    "appId": "cn.projectnexus.desktop",
    "productName": "PROJECT NEXUS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "nexus-memory.js",
      "!test-memory.js",
      "nexus-features.js",
      "!test-features.js",
      "nexus-log-diagnostics.js",
      "!test-logs.js",
      "!test-ipc.js",
      "!test-ui.js",
      "nexus-folders.js",
      "!test-folders.js"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PROJECT_NEXUS_${version}_${arch}_Installer.${ext}"
    },
    "portable": {
      "artifactName": "PROJECT_NEXUS_${version}_${arch}_Portable.${ext}"
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "docx": "^9.5.1"
  }
}
