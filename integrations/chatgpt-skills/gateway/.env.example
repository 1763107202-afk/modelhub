# Use a random secret of at least 16 characters. Do not commit .env or secrets.
INTEGRATION_KEY=replace-with-unique-random-secret
PORT=8787
# These are URLs of YOUR adapters implementing POST {"task":"...","input":{}}.
# They are NOT the raw upstream project URLs. Empty means unavailable.
TASTE_ADAPTER_URL=
AGENT_REACH_ADAPTER_URL=
ARCHIFY_ADAPTER_URL=
VOICESTUDIO_ADAPTER_URL=
MIROFISH_ADAPTER_URL=

# Optional self-hosted adapter for the Anatomy renderer; upstream repo homepage is NOT an adapter.
ANATOMY_ADAPTER_URL=
